<UserControl x:Class="WpfCustomUI.Gallery.Pages.PropertyGridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="PropertyGrid"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ui:PropertyGrid x:Name="Grid1" />
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,36,0,0">
            <TextBlock Text="デモ内容" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                <Run Text="・カテゴリの折りたたみ(ヘッダークリック)" /><LineBreak />
                <Run Text="・上部ボックスで項目名フィルタ" /><LineBreak />
                <Run Text="・行にホバーすると説明ツールチップ" /><LineBreak />
                <Run Text="・「板厚」は IUnitProvider 連携(mm 表示、内部 m)" /><LineBreak />
                <Run Text="・「解析タイプ」を変えると下の行が動的に入れ替わる" /><LineBreak />
                <Run Text="・「ID」は読み取り専用" />
            </TextBlock>
            <TextBlock x:Name="ValueMonitor"
                       Margin="0,16,0,0"
                       FontFamily="{StaticResource Wcu.FontFamily.Monospace}"
                       Foreground="{DynamicResource Wcu.Brush.Text.Secondary}" />
        </StackPanel>
    </Grid>
</UserControl>
