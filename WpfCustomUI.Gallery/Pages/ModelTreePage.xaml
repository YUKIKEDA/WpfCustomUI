<UserControl x:Class="WpfCustomUI.Gallery.Pages.ModelTreePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="ModelTree"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="すべて展開" Click="OnExpandAll" />
                <Button Content="すべて折りたたみ" Click="OnCollapseAll" Margin="8,0,0,0" />
            </StackPanel>
            <ui:ModelTree x:Name="Tree" SelectionChanged="OnTreeSelectionChanged">
                <ui:ModelTree.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="ズーム" />
                        <MenuItem Header="分離表示" />
                        <Separator />
                        <MenuItem Header="削除" />
                    </ContextMenu>
                </ui:ModelTree.ContextMenu>
            </ui:ModelTree>
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,36,0,0">
            <TextBlock Text="デモ内容" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                <Run Text="・シェブロン / ダブルクリックなしのワンクリック展開" /><LineBreak />
                <Run Text="・Ctrl / Shift による複数選択、矢印キー(←→で開閉)" /><LineBreak />
                <Run Text="・目アイコン: 親をクリックすると子孫全てに伝播" /><LineBreak />
                <Run Text="  子の一部のみ非表示なら親は半透明(混在)表示" /><LineBreak />
                <Run Text="・右クリックで行選択+コンテキストメニュー" /><LineBreak />
                <Run Text="・「Result Sets」以下は 2000 ノード(仮想化の確認用)" />
            </TextBlock>
            <TextBlock x:Name="SelectionInfo"
                       Margin="0,16,0,0"
                       Foreground="{DynamicResource Wcu.Brush.Text.Secondary}"
                       Text="選択: 0 個" />
        </StackPanel>
    </Grid>
</UserControl>
