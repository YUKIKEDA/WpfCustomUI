<UserControl x:Class="WpfCustomUI.Gallery.Pages.ViewportBenchmarkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Benchmark (大規模メッシュ性能)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="合成波面メッシュ(パラメトリック生成)で大規模メッシュの構築・描画性能を計測する(spec 6.22 / 6.23)。頂点/インデックスバッファはチャンク分割+フラスタムカリングされ、500万三角形超では操作中 LOD(グリッドクラスタリング約 1/20)が自動で効く。GPU ID ピック・コンター・統計 API(GetStatistics)の参照実装を兼ねる。1億は RAM 16GB+/VRAM 6GB+、2億は RAM 32GB+/VRAM 12GB+ が目安。" />

            <WrapPanel Margin="0,12,0,4" ItemHeight="30">
                <TextBlock Text="三角形数:" VerticalAlignment="Center" />
                <ComboBox x:Name="SizeCombo" Width="110" Margin="8,0,0,0" SelectedIndex="1"
                          AutomationProperties.AutomationId="SizeCombo"
                          SelectionChanged="OnSizeChanged">
                    <ComboBoxItem Content="10万" Tag="100000" />
                    <ComboBoxItem Content="100万" Tag="1000000" />
                    <ComboBoxItem Content="500万" Tag="5000000" />
                    <ComboBoxItem Content="1,000万" Tag="10000000" />
                    <ComboBoxItem Content="2,500万" Tag="25000000" />
                    <ComboBoxItem Content="5,000万" Tag="50000000" />
                    <ComboBoxItem Content="1億" Tag="100000000" />
                    <ComboBoxItem Content="2億" Tag="200000000" />
                </ComboBox>
                <ui:ToggleSwitch x:Name="RotateToggle" Content="回転アニメ(FPS 計測)" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="RotateToggle"
                                 Checked="OnRotateToggleChanged" Unchecked="OnRotateToggleChanged" />
                <ui:ToggleSwitch x:Name="LodToggle" Content="操作中 LOD" IsChecked="True" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="LodToggle"
                                 Checked="OnLodToggleChanged" Unchecked="OnLodToggleChanged" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                <Button Content="Top" Click="OnTopViewClick" MinWidth="60" Margin="8,0,0,0"
                        AutomationProperties.AutomationId="TopViewButton" />
            </WrapPanel>

            <ui:WcuViewport x:Name="Viewport"
                            Height="440"
                            PickMode="Face"
                            DeformationScale="0" />

            <TextBlock x:Name="StatsText" Style="{StaticResource Hint}" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="StatsText"
                       Text="(構築待ち)" />
            <TextBlock x:Name="FpsText" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="FpsText"
                       Text="FPS: -" />
            <TextBlock x:Name="PickText" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="PickText"
                       Text="ピック: クリックで面を選択(大規模でもチャンク基点オフセットで三角形 ID が一致することの確認)" />
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="構築時間は法線計算(octahedral 16bit 圧縮)・チャンク分割・LOD 構築(グリッドクラスタリング)・GPU 転送の合計。EdgeExtractionLimit(既定 500万三角形)超はエッジ抽出をスキップ、InteractiveLodThreshold(既定 500万三角形)超は操作中 LOD を構築する(「操作中 LOD」トグルは閾値の切替)。描画時間はコマンド発行から GPU 完了待ちまでの 1 フレーム実測。回転アニメ中は LOD 描画の FPS、静止時はフル解像度描画になる(統計の「LOD描画中」で確認可)。描画チャンク数はフラスタムカリング後の実描画数で、ズームインすると減る。" />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
