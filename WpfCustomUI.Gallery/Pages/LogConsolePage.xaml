<UserControl x:Class="WpfCustomUI.Gallery.Pages.LogConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="LogConsole &amp; ProgressDisplay"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

            <Border DockPanel.Dock="Top"
                    Background="{DynamicResource Wcu.Brush.Surface.Panel}"
                    BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Wcu.CornerRadius}"
                    Padding="12,8"
                    Margin="0,0,0,8">
                <ui:ProgressDisplay x:Name="Progress"
                                    Text="待機中"
                                    CancelText="キャンセル" />
            </Border>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="StartButton" Content="解析開始" Click="OnStart" />
                <Button Content="10,000 行バースト" Click="OnBurst" Margin="8,0,0,0" />
                <Button Content="クリア" Click="OnClear" Margin="8,0,0,0" />
                <CheckBox x:Name="TimestampCheck" Content="タイムスタンプ" IsChecked="True"
                          Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ui:LogConsole x:Name="Console"
                           ShowTimestamps="{Binding ElementName=TimestampCheck, Path=IsChecked}" />
        </DockPanel>

        <StackPanel Grid.Column="1" Margin="24,44,0,0">
            <TextBlock Text="デモ内容" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                <Run Text="・「解析開始」でソルバー実行をシミュレート" /><LineBreak />
                <Run Text="  (進捗+経過時間+キャンセル連動)" /><LineBreak />
                <Run Text="・ログはバックグラウンドスレッドから Append され、" /><LineBreak />
                <Run Text="  100ms ごとにまとめて UI に反映される" /><LineBreak />
                <Run Text="・最下部にいる時だけ自動スクロール" /><LineBreak />
                <Run Text="  (上にスクロールすると追従停止)" /><LineBreak />
                <Run Text="・行を選択して Ctrl+C でコピー" /><LineBreak />
                <Run Text="・保持上限 5,000 行のリングバッファ" /><LineBreak />
                <Run Text="  (バーストで古い行が消えるのを確認可)" />
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
