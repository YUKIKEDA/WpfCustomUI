<UserControl x:Class="WpfCustomUI.Gallery.Pages.NumericPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="700" HorizontalAlignment="Left">

            <TextBlock Text="NumericBox &amp; Expander"
                       FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />

            <TextBlock Text="基本(単位ラベル・スピン・範囲)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <ui:NumericBox x:Name="BasicBox" Width="160" Margin="0,0,8,0"
                               Value="25" Minimum="0" Maximum="100" Increment="5" Unit="mm" />
                <ui:NumericBox Width="160" Margin="0,0,8,0" Value="3.2" Unit="mm" IsReadOnly="True" />
                <ui:NumericBox Width="160" Value="1.5" Unit="mm" IsEnabled="False" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Enter / フォーカス移動で確定、Esc で復元。↑↓キー・ホイール・ボタンで ±5。範囲は 0〜100。" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding ElementName=BasicBox, Path=Value, StringFormat='Value = {0}'}" />

            <TextBlock Text="指数表記" Style="{StaticResource SectionHeader}" />
            <ui:NumericBox Width="160" HorizontalAlignment="Left" Value="0.00125" Format="G4" Unit="m" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="&quot;1e-3&quot; や &quot;2.5E+6&quot; の形式で入力できます。" />

            <TextBlock Text="単位換算(IUnitProvider: 内部 m ↔ 表示 mm)" Style="{StaticResource SectionHeader}" />
            <ui:NumericBox x:Name="LengthBox" Width="160" HorizontalAlignment="Left"
                           Value="0.05" Minimum="0" Maximum="1" Increment="10" />
            <TextBlock Margin="0,4,0,0"
                       Text="{Binding ElementName=LengthBox, Path=Value, StringFormat='内部値 = {0} m'}" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="表示は mm、内部値は m。&quot;500 mm&quot;、&quot;50 cm&quot;、&quot;0.5 m&quot; のように単位付きでも入力できます(内部値はいずれも 0.5)。範囲は 0〜1 m なので &quot;1500&quot; はエラー。" />

            <TextBlock Text="検証エラー(赤枠+ツールチップ)" Style="{StaticResource SectionHeader}" />
            <ui:NumericBox Width="160" HorizontalAlignment="Left"
                           Value="200" Minimum="0" Maximum="1000" Unit="MPa" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="&quot;abc&quot; や &quot;-5&quot;(範囲外)を入力して Enter を押すと、赤枠+ツールチップでエラー表示。" />

            <TextBlock Text="Expander" Style="{StaticResource SectionHeader}" />
            <StackPanel MaxWidth="400">
                <Expander Header="材料物性" IsExpanded="True" Margin="0,0,0,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="ヤング率" VerticalAlignment="Center" />
                        <ui:NumericBox Grid.Column="1" Value="205" Unit="GPa" Margin="0,2" />
                        <TextBlock Grid.Row="1" Text="ポアソン比" VerticalAlignment="Center" />
                        <ui:NumericBox Grid.Row="1" Grid.Column="1" Value="0.3" Minimum="0" Maximum="0.5" Increment="0.05" Margin="0,2" />
                        <TextBlock Grid.Row="2" Text="密度" VerticalAlignment="Center" />
                        <ui:NumericBox Grid.Row="2" Grid.Column="1" Value="7850" Unit="kg/m³" Margin="0,2" />
                    </Grid>
                </Expander>
                <Expander Header="メッシュ設定(折りたたみ)">
                    <TextBlock Text="要素サイズなどの設定がここに入ります。"
                               Foreground="{DynamicResource Wcu.Brush.Text.Secondary}" />
                </Expander>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
