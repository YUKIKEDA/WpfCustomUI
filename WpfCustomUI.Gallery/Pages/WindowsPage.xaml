<UserControl x:Class="WpfCustomUI.Gallery.Pages.WindowsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <!-- ToastHost をページ全面に重ねるため、ルートは Grid -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Windows(WcuWindow / ダイアログ / Toast / BusyOverlay)"
                           FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                <!-- WcuMessageBox -->
                <GroupBox Header="WcuMessageBox" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="情報 (OK)" Click="InfoMessage_Click" />
                            <Button Content="確認 (YesNoCancel)" Margin="8,0,0,0" Click="ConfirmMessage_Click" />
                            <Button Content="警告 (OKCancel)" Margin="8,0,0,0" Click="WarningMessage_Click" />
                            <Button Content="エラー (OK)" Margin="8,0,0,0" Click="ErrorMessage_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                            <Run Text="戻り値: " /><Run x:Name="MessageResult" Text="(なし)" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- ウィンドウ / ダイアログ -->
                <GroupBox Header="WcuWindow / WcuDialogWindow" Margin="0,0,0,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="ツールウィンドウを開く" Click="OpenToolWindow_Click" />
                            <Button Content="カスタムダイアログを開く" Margin="8,0,0,0" Click="OpenDialog_Click" />
                        </StackPanel>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                            <Run Text="・このギャラリー自体も WcuWindow(カスタムクローム)で表示している" /><LineBreak />
                            <Run Text="・ツールウィンドウはタイトルバーにメニューを埋め込む TitleBarContent の例" /><LineBreak />
                            <Run Text="・ダイアログは WcuDialogWindow 派生+Footer にボタンバーを置く例" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Toast -->
                <GroupBox Header="ToastHost" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="情報" Click="InfoToast_Click" />
                        <Button Content="成功" Margin="8,0,0,0" Click="SuccessToast_Click" />
                        <Button Content="警告" Margin="8,0,0,0" Click="WarningToast_Click" />
                        <Button Content="エラー (8秒)" Margin="8,0,0,0" Click="ErrorToast_Click" />
                    </StackPanel>
                </GroupBox>

                <!-- BusyOverlay -->
                <GroupBox Header="BusyOverlay">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="3秒間ビジーにする" Click="StartBusy_Click" />
                        </StackPanel>
                        <Grid Height="180">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 既定表示(スピナー+テキスト) -->
                            <ui:BusyOverlay x:Name="DefaultBusyOverlay" BusyText="メッシュを生成しています...">
                                <Border Background="{DynamicResource Wcu.Brush.Surface.Panel}"
                                        BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="既定表示(スピナー)" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBox Text="ビジー中は操作できない" Margin="0,0,0,8" />
                                        <Button Content="ダミーボタン" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </ui:BusyOverlay>

                            <!-- カスタムコンテンツ(ProgressDisplay) -->
                            <ui:BusyOverlay x:Name="ProgressBusyOverlay" Grid.Column="2">
                                <ui:BusyOverlay.BusyContent>
                                    <ui:ProgressDisplay x:Name="BusyProgress"
                                                        Width="260"
                                                        Text="解析を実行中..."
                                                        IsIndeterminate="True" />
                                </ui:BusyOverlay.BusyContent>
                                <Border Background="{DynamicResource Wcu.Brush.Surface.Panel}"
                                        BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                                        BorderThickness="1" Padding="12">
                                    <StackPanel>
                                        <TextBlock Text="BusyContent = ProgressDisplay" FontWeight="SemiBold" Margin="0,0,0,8" />
                                        <TextBox Text="ビジー中は操作できない" Margin="0,0,0,8" />
                                        <Button Content="ダミーボタン" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                            </ui:BusyOverlay>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- トースト通知のホスト(右下に重ねる) -->
        <ui:ToastHost x:Name="Toasts" />
    </Grid>
</UserControl>
