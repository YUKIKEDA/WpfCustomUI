<UserControl x:Class="WpfCustomUI.Gallery.Pages.IconsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:wcu="clr-namespace:WpfCustomUI.Controls;assembly=WpfCustomUI.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="Icons" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Foreground="{DynamicResource Wcu.Brush.Text.Secondary}"
                       TextWrapping="Wrap"
                       Text="WcuIcon + WcuIcons: 16x16 グリッドのストローク式ラインアイコン(依存ゼロの内蔵 Geometry)。XAML からは {x:Static wcu:WcuIcons.Save} または Wcu.Icon.* リソースキーで参照。色は Foreground(テーマトークン)、サイズは Viewbox 拡大でストロークごとスケール。" />

            <TextBlock Text="サイズ (16 / 24 / 32 / 48)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Settings}" Size="16" Margin="0,0,12,0" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Settings}" Size="24" Margin="0,0,12,0" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Settings}" Size="32" Margin="0,0,12,0" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Settings}" Size="48" />
            </StackPanel>

            <TextBlock Text="色 (Foreground トークン)" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Info}" Size="24" Margin="0,0,12,0"
                             Foreground="{DynamicResource Wcu.Brush.Info}" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Warning}" Size="24" Margin="0,0,12,0"
                             Foreground="{DynamicResource Wcu.Brush.Warning}" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Error}" Size="24" Margin="0,0,12,0"
                             Foreground="{DynamicResource Wcu.Brush.Error}" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Success}" Size="24" Margin="0,0,12,0"
                             Foreground="{DynamicResource Wcu.Brush.Success}" />
                <wcu:WcuIcon Icon="{x:Static wcu:WcuIcons.Play}" Size="24" Margin="0,0,12,0"
                             Foreground="{DynamicResource Wcu.Brush.Accent.Default}" />
                <!-- リソースキー参照の例 -->
                <wcu:WcuIcon Icon="{StaticResource Wcu.Icon.Save}" Size="24"
                             Foreground="{DynamicResource Wcu.Brush.Text.Secondary}" />
            </StackPanel>

            <TextBlock x:Name="IconCountHeader" Style="{StaticResource SectionHeader}" />
            <ItemsControl x:Name="IconList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="84" Margin="0,0,2,12" ToolTip="{Binding Name}">
                            <wcu:WcuIcon Icon="{Binding Geometry}" Size="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}"
                                       FontSize="{StaticResource Wcu.FontSize.S}"
                                       Foreground="{DynamicResource Wcu.Brush.Text.Secondary}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="2,3,2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
