<UserControl x:Class="WpfCustomUI.Gallery.Pages.ChartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.L}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ChartPanel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Panel}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left">

            <TextBlock Text="Charts (ScottPlot)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="WpfCustomUI.Charts は ScottPlot 5(MIT)を土台に、Wcu トークン配色の WcuPlot と CAE 向け複合コントロール4種を提供する別アセンブリ。コアは依存ゼロのまま。チャートのズームは Ctrl+ホイール(左ドラッグ=パン、右ドラッグ=ズーム)。素のホイールはページスクロールに素通しされる。" />

            <TextBlock Text="ConvergenceMonitor(ソルバー残差のストリーミング)" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource ChartPanel}">
                <StackPanel Width="620">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Button x:Name="SolveButton" Content="解析開始" Click="OnSolveClick" MinWidth="90" />
                        <Button x:Name="StopButton" Content="停止" Click="OnStopClick"
                                MinWidth="70" Margin="8,0,0,0" IsEnabled="False" />
                        <TextBlock x:Name="SolveStatus" Text="待機中"
                                   VerticalAlignment="Center" Margin="16,0,0,0"
                                   Foreground="{DynamicResource Wcu.Brush.Text.Secondary}" />
                    </StackPanel>
                    <ui:ConvergenceMonitor x:Name="Convergence"
                                           Height="260"
                                           Threshold="1e-6"
                                           XLabel="Iteration"
                                           YLabel="Residual" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}"
                       Text="ConvergenceSeries.Append(residual) はスレッドセーフで、ソルバーのワーカースレッドから直接呼べる。再描画は約 100ms にスロットリング。縦軸は対数(IsLogScale)、破線は収束判定値(Threshold)。" />

            <TextBlock Text="HistoryChart(荷重-変位曲線・時刻歴)" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource ChartPanel}">
                <ui:HistoryChart x:Name="History"
                                 Width="620" Height="280"
                                 XLabel="Displacement [mm]"
                                 YLabel="Load [kN]" />
            </Border>
            <TextBlock Style="{StaticResource Hint}"
                       Text="ChartSeries(Name / X / Y / Color)のコレクションを SeriesSource にバインドする既存の流儀。データ更新は配列インスタンスの差し替えで通知。ホバーで十字カーソル+座標読取(ShowCrosshair)。" />

            <TextBlock Text="FrequencyResponsePlot(周波数応答・ボード線図)" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource ChartPanel}">
                <StackPanel Width="620">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:ToggleSwitch x:Name="PhaseToggle" Content="位相を表示" IsChecked="True" />
                        <ui:ToggleSwitch x:Name="DecibelToggle" Content="dB 表示" IsChecked="True" Margin="24,0,0,0" />
                    </StackPanel>
                    <ui:FrequencyResponsePlot x:Name="Frf"
                                              Height="340"
                                              ShowPhase="{Binding IsChecked, ElementName=PhaseToggle}"
                                              MagnitudeInDecibels="{Binding IsChecked, ElementName=DecibelToggle}"
                                              XLabel="Frequency [Hz]" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}"
                       Text="上段=振幅、下段=位相の 2 段構成で、横軸(対数周波数)はズーム・パンに連動して同期する。FrequencyResponseSeries(Frequencies / Magnitudes / Phases)を SeriesSource にバインド。" />

            <TextBlock Text="HistogramChart(応力分布)" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource ChartPanel}">
                <StackPanel Width="620">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="ビン数" VerticalAlignment="Center" />
                        <Slider x:Name="BinSlider" Width="160" Minimum="5" Maximum="60"
                                Value="24" TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Value, ElementName=BinSlider, StringFormat={}{0:0}}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="24" />
                        <ui:ToggleSwitch x:Name="NormalizeToggle" Content="密度に正規化" Margin="24,0,0,0" />
                    </StackPanel>
                    <ui:HistogramChart x:Name="Histogram"
                                       Height="240"
                                       BinCount="{Binding Value, ElementName=BinSlider}"
                                       Normalize="{Binding IsChecked, ElementName=NormalizeToggle}"
                                       XLabel="von Mises stress [MPa]" />
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Hint}"
                       Text="Values に数値列を渡すと BinCount で自動集計。Normalize=true で確率密度表示。" />

            <TextBlock Text="素の WcuPlot(ScottPlot 素通し)" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource ChartPanel}">
                <ui:WcuPlot x:Name="FreePlot" Width="620" Height="240" />
            </Border>
            <TextBlock Style="{StaticResource Hint}"
                       Text="複合コントロールで足りない場合は WcuPlot を直接使い、ScottPlot API(FreePlot.Plot.Add.*)をフルに叩ける。Wcu 配色は適用済みで、テーマ・アクセント変更にも自動追従する。静的な WcuChartTheme.Apply(plot) で画像出力用 Plot にも同じ配色を適用できる。" />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
