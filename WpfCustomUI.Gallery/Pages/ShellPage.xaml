<UserControl x:Class="WpfCustomUI.Gallery.Pages.ShellPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Geometry x:Key="Icon.Open">M1.5,3 H6 L7.5,4.5 H14.5 V6 H3.8 L2,12.5 H1.5 Z M4.5,7 H15.5 L13.5,13 H2.7 Z</Geometry>
        <Geometry x:Key="Icon.Save">M2,2 H11.5 L14,4.5 V14 H2 Z M4,3.5 V6.5 H10 V3.5 Z M4,9 H12 V12.5 H4 Z</Geometry>
        <Geometry x:Key="Icon.Undo">M4.5,7 L8.5,3 V5.7 C11.8,5.7 13.8,7.8 13.8,11.2 C12.8,9.4 11,8.7 8.5,8.7 V11 Z</Geometry>
        <Geometry x:Key="Icon.Mesh">M3,3 H7 V7 H3 Z M9,3 H13 V7 H9 Z M3,9 H7 V13 H3 Z M9,9 H13 V13 H9 Z</Geometry>
        <Geometry x:Key="Icon.Run">M4,2.5 L13,8 L4,13.5 Z</Geometry>
    </UserControl.Resources>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Shell(ToolBar / StatusBar / GridSplitter / SearchBox)"
                   FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                BorderThickness="1">
            <DockPanel>
                <!-- ツールバー(幅を狭めるとオーバーフローメニューに退避する) -->
                <ToolBarTray DockPanel.Dock="Top">
                    <ToolBar>
                        <Button ToolTip="開く">
                            <Path Data="{StaticResource Icon.Open}" Fill="{DynamicResource Wcu.Brush.Text.Primary}"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Button ToolTip="保存">
                            <Path Data="{StaticResource Icon.Save}" Fill="{DynamicResource Wcu.Brush.Text.Primary}"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <Separator />
                        <Button ToolTip="元に戻す">
                            <Path Data="{StaticResource Icon.Undo}" Fill="{DynamicResource Wcu.Brush.Text.Primary}"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </Button>
                        <ToggleButton ToolTip="メッシュ表示" IsChecked="True">
                            <Path Data="{StaticResource Icon.Mesh}" Fill="{DynamicResource Wcu.Brush.Text.Primary}"
                                  Width="16" Height="16" Stretch="Uniform" />
                        </ToggleButton>
                    </ToolBar>
                    <ToolBar>
                        <Button ToolTip="解析実行">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Run}" Fill="{DynamicResource Wcu.Brush.Success}"
                                      Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="実行" Margin="4,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </ToolBar>
                </ToolBarTray>

                <!-- ステータスバー -->
                <StatusBar DockPanel.Dock="Bottom">
                    <StatusBarItem Content="準備完了" />
                    <Separator />
                    <StatusBarItem Content="節点: 45,230 / 要素: 38,911" />
                    <Separator />
                    <StatusBarItem Content="単位系: SI (m, kg, s)" />
                    <StatusBarItem DockPanel.Dock="Right" Content="X: 12.5  Y: -3.2  Z: 0.0" />
                </StatusBar>

                <!-- GridSplitter によるペイン分割 -->
                <Grid Margin="8" Height="300">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" MinWidth="120" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" MinWidth="120" />
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="部品リスト(SearchBox デモ)">
                        <DockPanel>
                            <ui:SearchBox x:Name="PartsSearch"
                                          DockPanel.Dock="Top"
                                          Placeholder="部品名で検索..."
                                          Margin="0,0,0,6" />
                            <TextBlock DockPanel.Dock="Bottom"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
                                <Run Text="確定値(200ms デバウンス): " /><Run x:Name="SearchEcho" Text="(なし)" />
                            </TextBlock>
                            <ListBox x:Name="PartsList" />
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  ResizeBehavior="PreviousAndNext" />

                    <GroupBox Grid.Column="2" Header="ビューポート(ダミー)">
                        <Border Background="{DynamicResource Wcu.Brush.Surface.Window}">
                            <TextBlock Text="3D Viewport"
                                       Foreground="{DynamicResource Wcu.Brush.Text.Disabled}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Margin="0,12,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource Wcu.Brush.Text.Secondary}">
            <Run Text="・ウィンドウ幅を狭めるとツールバーのボタンがオーバーフローメニューに退避する" /><LineBreak />
            <Run Text="・中央の分割線をドラッグするとペイン幅が変わる(ホバー/ドラッグでハイライト)" /><LineBreak />
            <Run Text="・検索欄は打鍵停止から 200ms 後に確定値が反映される(Enter で即時、Esc でクリア)" /><LineBreak />
            <Run Text="・PropertyGrid ページのフィルタ欄も同じ SearchBox に置き換え済み" />
        </TextBlock>
        <Border />
    </DockPanel>
</UserControl>
