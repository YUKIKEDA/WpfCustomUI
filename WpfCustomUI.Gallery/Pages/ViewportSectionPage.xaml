<UserControl x:Class="WpfCustomUI.Gallery.Pages.ViewportSectionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="{StaticResource Wcu.FontSize.S}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="3D Section (断面カット)" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Hint}"
                       Text="WcuViewport.SectionPlane(点+法線)による GPU クリッピング平面。法線側が残り、切り口は開放(中空に見える)。デモは内圧を受ける厚肉円筒(Lamé の解析解)の von Mises 応力コンター。断面位置のスライスメッシュ(IsClippable=false)はアプリ側で計算して重ねる参照実装。左クリック/左ドラッグで面選択でき、クリップで隠れた面はピックにも掛からない。" />

            <!-- 断面平面の定義 -->
            <WrapPanel Margin="0,12,0,4" ItemHeight="28">
                <ui:ToggleSwitch x:Name="ClipToggle" Content="断面カット" IsChecked="True"
                                 AutomationProperties.AutomationId="ClipToggle"
                                 Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
                <TextBlock Text="法線軸:" VerticalAlignment="Center" Margin="20,0,8,0" />
                <ComboBox x:Name="AxisCombo" MinWidth="70" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="AxisCombo"
                          SelectionChanged="OnSectionOptionChanged">
                    <ComboBoxItem Content="X" IsSelected="True" />
                    <ComboBoxItem Content="Y" />
                    <ComboBoxItem Content="Z" />
                </ComboBox>
                <TextBlock Text="オフセット:" VerticalAlignment="Center" Margin="20,0,8,0" />
                <Slider x:Name="OffsetSlider" Width="180" VerticalAlignment="Center"
                        AutomationProperties.AutomationId="OffsetSlider"
                        Minimum="-48" Maximum="48" Value="0"
                        ValueChanged="OnSectionOptionChanged" />
                <TextBlock VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="OffsetText"
                           Text="{Binding Value, ElementName=OffsetSlider, StringFormat={}{0:0} mm}" />
                <ui:ToggleSwitch x:Name="FlipToggle" Content="反転" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="FlipToggle"
                                 Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
            </WrapPanel>

            <!-- 表示オプション -->
            <WrapPanel Margin="0,0,0,8" ItemHeight="28">
                <ui:ToggleSwitch x:Name="IndicatorToggle" Content="平面インジケータ" IsChecked="True"
                                 AutomationProperties.AutomationId="IndicatorToggle" />
                <ui:ToggleSwitch x:Name="SliceToggle" Content="断面スライス(アプリ実装)" IsChecked="True" Margin="20,0,0,0"
                                 AutomationProperties.AutomationId="SliceToggle"
                                 Checked="OnSectionOptionChanged" Unchecked="OnSectionOptionChanged" />
                <ui:ToggleSwitch x:Name="ContourToggle" Content="コンター" IsChecked="True" Margin="20,0,0,0" />
                <Button Content="Fit" Click="OnFitClick" MinWidth="60" Margin="20,0,0,0" />
                <Button Content="選択解除" Click="OnClearSelectionClick" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="ClearSelectionButton" />
            </WrapPanel>

            <!-- ビューポート + 凡例 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:WcuViewport x:Name="Viewport"
                                Grid.Column="0"
                                Height="420"
                                PickMode="Face"
                                ShowSectionPlaneIndicator="{Binding IsChecked, ElementName=IndicatorToggle}"
                                ShowContours="{Binding IsChecked, ElementName=ContourToggle}" />

                <ui:ColorMapLegend x:Name="Legend"
                                   Grid.Column="1"
                                   Height="280"
                                   Margin="16,0,0,0"
                                   VerticalAlignment="Center"
                                   Title="σ_vM [MPa]" />
            </Grid>
            <TextBlock x:Name="SelectionSummary" Style="{StaticResource Hint}"
                       AutomationProperties.AutomationId="SelectionSummary"
                       Text="Parts: 0, Faces: 0, Nodes: 0" />
            <TextBlock x:Name="RendererInfo" Style="{StaticResource Hint}" />

            <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                       Text="クリップは全描画パス共通の SV_ClipDistance(頂点シェーダで符号付き距離を出力)。切り口は開放のため、断面コンターが必要な場合はアプリが平面との交差領域をメッシュ化し IsClippable=false で追加する(このページの断面スライスがその参照実装)。エッジ・選択ハイライト・ピック(GPU ID パス)も同じ平面でクリップされ、表示とピックが常に一致する。" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="Lamé 解: σr = A − B/r²、σθ = A + B/r²、σz = A(閉端)。A = p·a²/(b²−a²)、B = A·b²。内面で von Mises 応力が最大になる。平面の反転は SectionPlane の法線符号の反転で、どちら側を残すかが切り替わる。" />

            <Border Height="24" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
