<ui:WcuDialogWindow x:Class="CaeStudio.App.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
                    xmlns:converters="clr-namespace:CaeStudio.App.Converters"
                    Title="設定"
                    Width="520" SizeToContent="Height"
                    ResizeMode="NoResize">

    <ui:WcuDialogWindow.Resources>
        <converters:KeyGestureStringConverter x:Key="GestureString" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
    </ui:WcuDialogWindow.Resources>

    <StackPanel Margin="20">
        <GroupBox Header="外観" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ライトテーマ" Style="{StaticResource FieldLabel}" />
                <ui:ToggleSwitch Grid.Column="1"
                                 AutomationProperties.AutomationId="SettingsLightTheme"
                                 HorizontalAlignment="Left"
                                 IsChecked="{Binding IsLightTheme.Value, Mode=TwoWay}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="ファイル" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="既定の保存先" Style="{StaticResource FieldLabel}" />
                <ui:PathBox Grid.Column="1"
                            AutomationProperties.AutomationId="SettingsDefaultDir"
                            Mode="Folder"
                            DialogTitle="プロジェクトの既定保存先"
                            SelectedPath="{Binding DefaultProjectDirectory.Value, Mode=TwoWay}" />
            </Grid>
        </GroupBox>

        <GroupBox Header="キーボード" Padding="12" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock Text="解析実行" Style="{StaticResource FieldLabel}" />
                <ui:KeyGestureBox Grid.Column="1"
                                  AutomationProperties.AutomationId="SettingsRunGesture"
                                  Gesture="{Binding RunGestureText.Value, Mode=TwoWay,
                                      Converter={StaticResource GestureString}}" />
            </Grid>
        </GroupBox>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="OK"
                    Width="88"
                    IsDefault="True"
                    AutomationProperties.AutomationId="SettingsOk"
                    Click="OnOkClick" />
            <Button Content="キャンセル"
                    Width="88"
                    Margin="8,0,0,0"
                    IsCancel="True" />
        </StackPanel>
    </StackPanel>
</ui:WcuDialogWindow>
