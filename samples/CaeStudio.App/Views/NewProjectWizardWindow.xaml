<ui:WcuDialogWindow x:Class="CaeStudio.App.Views.NewProjectWizardWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="https://schemas.wpfcustomui.dev/xaml"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:behaviors="clr-namespace:CaeStudio.App.Behaviors"
                    xmlns:converters="clr-namespace:CaeStudio.App.Converters"
                    Title="新規解析"
                    Width="620" Height="640">

    <ui:WcuDialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InvertBoolConverter x:Key="InvertBool" />
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </ui:WcuDialogWindow.Resources>

    <ui:Wizard Margin="8"
               CanFinish="{Binding CanFinish.Value, Mode=OneWay}"
               BackButtonText="戻る"
               NextButtonText="次へ"
               FinishButtonText="作成"
               CancelButtonText="キャンセル">
        <b:Interaction.Behaviors>
            <behaviors:WizardDialogBehavior />
        </b:Interaction.Behaviors>

        <!-- ステップ 1: テンプレート -->
        <ui:WizardStep Header="テンプレート">
            <StackPanel Margin="8,16">
                <RadioButton GroupName="Template"
                             IsChecked="{Binding IsPlate.Value}"
                             AutomationProperties.AutomationId="TemplatePlate">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="円孔付き平板の引張" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Text="一軸引張を受ける円孔まわりの応力集中(Kirsch 問題)。孔縁で公称応力の約 3 倍の応力が生じます。" />
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Template"
                             Margin="0,20,0,0"
                             IsChecked="{Binding IsBeam.Value}"
                             AutomationProperties.AutomationId="TemplateBeam">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="片持ち板の曲げ" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,0"
                                   Opacity="0.75"
                                   TextWrapping="Wrap"
                                   Text="固定端の面内曲げ。静解析は先端たわみ(δ = PL³/3EI)、固有値解析は固有振動数を梁理論と比較できます。" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </ui:WizardStep>

        <!-- ステップ 2: パラメータ -->
        <ui:WizardStep Header="パラメータ">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,12,16,12">
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="プロジェクト名" Style="{StaticResource FieldLabel}" />
                        <TextBox Grid.Column="1"
                                 AutomationProperties.AutomationId="WizardProjectName"
                                 Text="{Binding ProjectName.Value, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="解析タイプ" Style="{StaticResource FieldLabel}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton GroupName="AnalysisType"
                                         Content="静解析"
                                         AutomationProperties.AutomationId="WizardStatic"
                                         IsChecked="{Binding IsModalAnalysis.Value,
                                             Converter={StaticResource InvertBool}}" />
                            <RadioButton GroupName="AnalysisType"
                                         Content="固有値解析"
                                         Margin="16,0,0,0"
                                         AutomationProperties.AutomationId="WizardModal"
                                         IsChecked="{Binding IsModalAnalysis.Value}" />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="材料" Style="{StaticResource FieldLabel}" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Materials}"
                                  DisplayMemberPath="Name"
                                  SelectedItem="{Binding SelectedMaterial.Value}" />
                    </Grid>
                    <Grid Style="{StaticResource FieldRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="板厚 t" Style="{StaticResource FieldLabel}" />
                        <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="0.1" Maximum="1000"
                                       Value="{Binding Thickness.Value}" />
                    </Grid>

                    <!-- 円孔付き平板 -->
                    <StackPanel Visibility="{Binding IsPlate.Value, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,4,0,12" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="板幅 W" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="10" Maximum="10000"
                                           Value="{Binding PlateWidth.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="板高さ H" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="10" Maximum="10000"
                                           Value="{Binding PlateHeight.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="孔直径 d" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="1" Maximum="5000"
                                           Value="{Binding HoleDiameter.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="引張応力 σ" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="MPa" Minimum="0.001" Maximum="100000"
                                           Value="{Binding Tension.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="半径方向分割" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Minimum="4" Maximum="128" Format="0"
                                           Value="{Binding RadialDivisions.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="周方向分割" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Minimum="8" Maximum="512" Format="0"
                                           Value="{Binding AngularDivisions.Value}" />
                        </Grid>
                    </StackPanel>

                    <!-- 片持ち板 -->
                    <StackPanel Visibility="{Binding IsBeam.Value, Converter={StaticResource BoolToVisibility}}">
                        <Separator Margin="0,4,0,12" />
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="梁長さ L" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="10" Maximum="10000"
                                           Value="{Binding BeamLength.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="梁せい H" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="mm" Minimum="1" Maximum="5000"
                                           Value="{Binding BeamHeight.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="先端せん断 τ" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Unit="MPa" Minimum="0.001" Maximum="100000"
                                           Value="{Binding TipShear.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="x 方向分割" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Minimum="2" Maximum="1024" Format="0"
                                           Value="{Binding BeamDivisionsX.Value}" />
                        </Grid>
                        <Grid Style="{StaticResource FieldRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="y 方向分割" Style="{StaticResource FieldLabel}" />
                            <ui:NumericBox Grid.Column="1" Minimum="2" Maximum="256" Format="0"
                                           Value="{Binding BeamDivisionsY.Value}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ui:WizardStep>

        <!-- ステップ 3: 確認 -->
        <ui:WizardStep Header="確認">
            <Border Margin="8,12"
                    Padding="16"
                    Background="{DynamicResource Wcu.Brush.Surface.Panel}"
                    CornerRadius="4">
                <TextBlock AutomationProperties.AutomationId="WizardSummary"
                           Text="{Binding Summary.Value, Mode=OneWay}"
                           TextWrapping="Wrap"
                           LineHeight="22" />
            </Border>
        </ui:WizardStep>
    </ui:Wizard>
</ui:WcuDialogWindow>
