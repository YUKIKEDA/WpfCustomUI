<!--
    Wizard / WizardStep / StepIndicator の既定スタイル(spec 6.12.5)。
    Wizard は上段に StepIndicator、中段に現在ステップ、下段にナビゲーションボタンを置く。
    ステップの切り替えは Wizard 本体が WizardStep.Visibility で制御する(状態保持のため全ステップ生存)。
    ボタンは自己完結スタイル(他辞書への StaticResource 参照はマージ順依存になるため禁止)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <!-- ナビゲーションボタン(標準ボタンと同じ見た目の自己完結版) -->
    <Style x:Key="Wcu.Wizard.Button" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="Padding" Value="14,3" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wcu.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- アクセント塗りのプライマリボタン(次へ/完了用) -->
    <Style x:Key="Wcu.Wizard.PrimaryButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource Wcu.Wizard.Button}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Accent.Default}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ステップ1個分: [接続線] (番号丸) ヘッダー -->
    <Style TargetType="{x:Type wcu:StepIndicatorItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:StepIndicatorItem}">
                    <StackPanel Orientation="Horizontal">
                        <Rectangle x:Name="Connector"
                                   Width="24" Height="1"
                                   Margin="6,0"
                                   VerticalAlignment="Center"
                                   Fill="{DynamicResource Wcu.Brush.Border.Strong}" />
                        <Border x:Name="Circle"
                                Width="20" Height="20"
                                CornerRadius="10"
                                Background="Transparent"
                                BorderBrush="{DynamicResource Wcu.Brush.Border.Strong}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="Number"
                                           Text="{Binding StepNumber, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="{DynamicResource Wcu.FontSize.S}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Secondary}" />
                                <Path x:Name="CheckMark"
                                      Data="M 1.5,5.5 L 4.5,8.5 L 9.5,2.5"
                                      Stroke="{DynamicResource Wcu.Brush.Text.OnAccent}"
                                      StrokeThickness="1.6"
                                      Width="11" Height="11"
                                      Stretch="None"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirst" Value="True">
                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="Current">
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderThickness" Value="1.5" />
                            <Setter TargetName="Number" Property="Foreground"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
                        </Trigger>
                        <Trigger Property="State" Value="Completed">
                            <Setter TargetName="Circle" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Circle" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Connector" Property="Fill"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:StepIndicator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:StepIndicator}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WizardStep: Header は StepIndicator に出すため本体は Content のみ -->
    <Style TargetType="{x:Type wcu:WizardStep}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:WizardStep}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:Wizard}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:Wizard}">
                    <DockPanel>
                        <wcu:StepIndicator DockPanel.Dock="Top"
                                           Margin="0,0,0,12"
                                           ItemsSource="{TemplateBinding StepHeaders}"
                                           CurrentIndex="{Binding CurrentIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                            <Button x:Name="PART_CancelButton"
                                    Style="{StaticResource Wcu.Wizard.Button}"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding CancelButtonText}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="PART_BackButton"
                                        Style="{StaticResource Wcu.Wizard.Button}"
                                        Content="{TemplateBinding BackButtonText}" />
                                <Button x:Name="PART_NextButton"
                                        Style="{StaticResource Wcu.Wizard.PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsEnabled="{TemplateBinding CanGoNext}"
                                        Content="{TemplateBinding NextButtonText}" />
                                <Button x:Name="PART_FinishButton"
                                        Style="{StaticResource Wcu.Wizard.PrimaryButton}"
                                        Margin="8,0,0,0"
                                        IsEnabled="{TemplateBinding CanFinish}"
                                        Visibility="Collapsed"
                                        Content="{TemplateBinding FinishButtonText}" />
                            </StackPanel>
                        </Grid>
                        <ItemsPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFirstStep" Value="True">
                            <Setter TargetName="PART_BackButton" Property="IsEnabled" Value="False" />
                        </Trigger>
                        <Trigger Property="IsLastStep" Value="True">
                            <Setter TargetName="PART_NextButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_FinishButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
