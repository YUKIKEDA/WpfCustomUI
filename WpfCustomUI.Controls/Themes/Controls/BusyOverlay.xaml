<!--
    BusyOverlay の既定スタイル(spec 6.8.7)。
    IsBusy 中は半透明ベールで配下をブロックし、中央にスピナー+メッセージ、
    または BusyContent(ProgressDisplay 等)を表示する。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style TargetType="{x:Type wcu:BusyOverlay}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:BusyOverlay}">
                    <Grid>
                        <ContentPresenter x:Name="ContentHost" />

                        <Grid x:Name="Overlay" Visibility="Collapsed">
                            <!-- ベール(入力ブロックも兼ねる) -->
                            <Border Background="{DynamicResource Wcu.Brush.Surface.Window}"
                                    Opacity="0.7" />
                            <!-- 既定表示: スピナー+テキスト(BusyContent が null のときだけ表示) -->
                            <StackPanel x:Name="DefaultBusy"
                                        Visibility="Collapsed"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <!-- スピナーは ProgressRing(spec 6.10.4)。IsBusy 中だけ回転する -->
                                <wcu:ProgressRing x:Name="Spinner"
                                                  IsActive="{TemplateBinding IsBusy}"
                                                  HorizontalAlignment="Center" />
                                <TextBlock x:Name="BusyTextBlock"
                                           Text="{TemplateBinding BusyText}"
                                           Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Primary}" />
                            </StackPanel>
                            <!-- カスタムコンテンツ(ProgressDisplay 等) -->
                            <ContentPresenter x:Name="BusyContentHost"
                                              Content="{TemplateBinding BusyContent}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsBusy" Value="True">
                            <Setter TargetName="Overlay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentHost" Property="IsEnabled" Value="False" />
                        </Trigger>
                        <!-- BusyContent が null なら既定のスピナー表示に切り替える -->
                        <Trigger Property="BusyContent" Value="{x:Null}">
                            <Setter TargetName="DefaultBusy" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BusyContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
