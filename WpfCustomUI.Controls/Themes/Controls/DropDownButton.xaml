<!--
    DropDownButton / SplitButton の既定スタイル(spec 6.9.1)。
    メニュー表示中はボタンをヒットテスト対象外にすることで、
    「開いた状態でもう一度クリックすると閉じた直後に再度開いてしまう」定番の問題を避けている
    (メニューは外側クリックで先に閉じ、そのクリックはボタンに届かない)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style TargetType="{x:Type wcu:DropDownButton}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wcu.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:DropDownButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Path Grid.Column="1"
                                  Data="M 0,0 L 3,3 L 6,0"
                                  Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                                  StrokeThickness="1.2"
                                  VerticalAlignment="Center"
                                  Margin="0,1,8,0" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- メニュー表示中の再クリック抑止(ファイル冒頭のコメント参照) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type wcu:SplitButton}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wcu.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:SplitButton}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                            <Border Grid.Column="1" Width="1" Margin="0,3"
                                    Background="{DynamicResource Wcu.Brush.Border.Default}" />
                            <!-- 矢印部。クリックはコードビハインドが拾ってメニューを開く -->
                            <Button x:Name="PART_DropDownButton"
                                    Grid.Column="2"
                                    Focusable="False"
                                    Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="0,2,2,0">
                                            <Path Data="M 0,0 L 3,3 L 6,0"
                                                  Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                                                  StrokeThickness="1.2"
                                                  VerticalAlignment="Center"
                                                  Margin="6,1,6,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- メニュー表示中は矢印部のみヒットテスト対象外にする(本体は Command 実行可のまま) -->
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_DropDownButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_DropDownButton" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Strong}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Focus}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
