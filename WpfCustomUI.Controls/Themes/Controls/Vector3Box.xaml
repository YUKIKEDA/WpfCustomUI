<!--
    Vector3Box の既定スタイル(spec 6.9.5)。
    軸ラベル+NumericBox ×3 を等幅で横に並べる。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style x:Key="Wcu.Vector3Box.AxisLabel" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <Style TargetType="{x:Type wcu:Vector3Box}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:Vector3Box}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{TemplateBinding XLabel}"
                                   Style="{StaticResource Wcu.Vector3Box.AxisLabel}" />
                        <wcu:NumericBox Grid.Column="1"
                                        Value="{Binding X, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Increment="{TemplateBinding Increment}"
                                        Unit="{TemplateBinding Unit}"
                                        UnitProvider="{TemplateBinding UnitProvider}"
                                        Format="{TemplateBinding Format}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <TextBlock Grid.Column="2"
                                   Text="{TemplateBinding YLabel}"
                                   Style="{StaticResource Wcu.Vector3Box.AxisLabel}"
                                   Margin="8,0,4,0" />
                        <wcu:NumericBox Grid.Column="3"
                                        Value="{Binding Y, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Increment="{TemplateBinding Increment}"
                                        Unit="{TemplateBinding Unit}"
                                        UnitProvider="{TemplateBinding UnitProvider}"
                                        Format="{TemplateBinding Format}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}" />
                        <TextBlock Grid.Column="4"
                                   Text="{TemplateBinding ZLabel}"
                                   Style="{StaticResource Wcu.Vector3Box.AxisLabel}"
                                   Margin="8,0,4,0" />
                        <wcu:NumericBox Grid.Column="5"
                                        Value="{Binding Z, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Increment="{TemplateBinding Increment}"
                                        Unit="{TemplateBinding Unit}"
                                        UnitProvider="{TemplateBinding UnitProvider}"
                                        Format="{TemplateBinding Format}"
                                        IsReadOnly="{TemplateBinding IsReadOnly}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
