<!--
    ModelTree の既定スタイル(spec 6.3)。
    行テンプレートは Generic.xaml 単独でも解決できるよう自己完結にしている
    (他のコントロール辞書への StaticResource 参照はマージ順依存になるため禁止)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <wcu:TreeIndentConverter x:Key="Wcu.ModelTree.IndentConverter" IndentSize="16" />
    <BooleanToVisibilityConverter x:Key="Wcu.ModelTree.BoolToVisibility" />

    <!-- 目アイコン(表示/非表示)。FillRule=EvenOdd で瞳が抜ける -->
    <Geometry x:Key="Wcu.Icon.Eye">M8,3.5 C11.1,3.5 13.6,5.4 14.6,8 C13.6,10.6 11.1,12.5 8,12.5 C4.9,12.5 2.4,10.6 1.4,8 C2.4,5.4 4.9,3.5 8,3.5 Z M8,5.6 C6.67,5.6 5.6,6.67 5.6,8 C5.6,9.33 6.67,10.4 8,10.4 C9.33,10.4 10.4,9.33 10.4,8 C10.4,6.67 9.33,5.6 8,5.6 Z</Geometry>
    <Geometry x:Key="Wcu.Icon.EyeOff">M2.3,1.6 L14.4,13.7 L13.7,14.4 L1.6,2.3 Z M8,3.5 C11.1,3.5 13.6,5.4 14.6,8 C13.6,10.6 11.1,12.5 8,12.5 C4.9,12.5 2.4,10.6 1.4,8 C2.4,5.4 4.9,3.5 8,3.5 Z M8,5.6 C6.67,5.6 5.6,6.67 5.6,8 C5.6,9.33 6.67,10.4 8,10.4 C9.33,10.4 10.4,9.33 10.4,8 C10.4,6.67 9.33,5.6 8,5.6 Z</Geometry>

    <!-- 行内の小さなアイコンボタン(シェブロン・目)共通の透明スタイル -->
    <Style x:Key="Wcu.ModelTree.GhostButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Hover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 1行分のテンプレート -->
    <DataTemplate x:Key="Wcu.ModelTree.ItemTemplate" DataType="{x:Type wcu:FlatTreeItem}">
        <DockPanel Background="Transparent">
            <!-- 目アイコンは右端固定(インデントの影響を受けない)。三状態は Node.IsVisible が管理 -->
            <Button x:Name="PART_VisibilityToggle"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Wcu.ModelTree.GhostButton}"
                    Margin="4,0,0,0"
                    Visibility="{Binding ShowVisibilityToggles,
                                         RelativeSource={RelativeSource AncestorType={x:Type wcu:ModelTree}},
                                         Converter={StaticResource Wcu.ModelTree.BoolToVisibility}}">
                <Path x:Name="EyeIcon"
                      Data="{StaticResource Wcu.Icon.Eye}"
                      Fill="{DynamicResource Wcu.Brush.Text.Secondary}"
                      Width="14" Height="14"
                      Stretch="Uniform" />
            </Button>
            <StackPanel Orientation="Horizontal"
                        Margin="{Binding Level, Converter={StaticResource Wcu.ModelTree.IndentConverter}}">
                <ToggleButton x:Name="Chevron"
                              Style="{StaticResource Wcu.ModelTree.GhostButton}"
                              Width="16" Height="16"
                              ClickMode="Press"
                              IsChecked="{Binding Node.IsExpanded, Mode=TwoWay}">
                    <Path x:Name="ChevronIcon"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                          StrokeThickness="1.4"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                </ToggleButton>
                <Path x:Name="NodeIcon"
                      Data="{Binding Node.Icon}"
                      Fill="{DynamicResource Wcu.Brush.Text.Secondary}"
                      Width="14" Height="14"
                      Stretch="Uniform"
                      Margin="2,0,0,0"
                      VerticalAlignment="Center" />
                <TextBlock x:Name="NameText"
                           Text="{Binding Node.Name}"
                           Margin="4,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <!-- インライン名前変更(spec 6.12.3)。IsRenaming 中のみ表示され、ModelTree がフォーカス・確定を管理 -->
                <TextBox x:Name="PART_RenameBox"
                         Text="{Binding Node.Name, Mode=OneWay}"
                         Visibility="Collapsed"
                         MinWidth="100"
                         Margin="4,-2,0,-2"
                         Padding="2,0"
                         VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                <Setter TargetName="NameText" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_RenameBox" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.IsExpanded}" Value="True">
                <Setter TargetName="ChevronIcon" Property="RenderTransform">
                    <Setter.Value>
                        <RotateTransform Angle="90" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <!-- 子なし: シェブロンは非表示だがインデント揃えのため場所は確保 -->
            <DataTrigger Binding="{Binding HasChildren}" Value="False">
                <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
            </DataTrigger>
            <!-- 可視状態の三状態表示: 表示=目 / 混在=半透明の目 / 非表示=斜線入りの目+文字を淡色化 -->
            <DataTrigger Binding="{Binding Node.IsVisible}" Value="{x:Null}">
                <Setter TargetName="EyeIcon" Property="Opacity" Value="0.45" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.IsVisible}" Value="False">
                <Setter TargetName="EyeIcon" Property="Data" Value="{StaticResource Wcu.Icon.EyeOff}" />
                <Setter TargetName="EyeIcon" Property="Fill" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                <Setter TargetName="NodeIcon" Property="Fill" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Node.Icon}" Value="{x:Null}">
                <Setter TargetName="NodeIcon" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- 行コンテナ(全幅選択) -->
    <Style x:Key="Wcu.ModelTree.ItemContainer" TargetType="{x:Type ListBoxItem}">
        <Setter Property="IsSelected" Value="{Binding Node.IsSelected, Mode=TwoWay}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Selected}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="Selector.IsSelectionActive" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.SelectedInactive}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:ModelTree}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:ModelTree}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}">
                        <ListBox x:Name="PART_List"
                                 ItemsSource="{TemplateBinding FlatItems}"
                                 SelectionMode="{TemplateBinding SelectionMode}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0,2"
                                 Foreground="{TemplateBinding Foreground}"
                                 ItemContainerStyle="{StaticResource Wcu.ModelTree.ItemContainer}"
                                 ItemTemplate="{StaticResource Wcu.ModelTree.ItemTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
