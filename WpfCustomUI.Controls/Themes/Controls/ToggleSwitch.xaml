<!--
    ToggleSwitch の既定スタイル(spec 6.10.3)。
    高密度 UI 基準(ControlHeight 24px)に収まる 32×16 のトラック。
    ラベルは Content(右側)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style TargetType="{x:Type wcu:ToggleSwitch}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Strong}" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource Wcu.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:ToggleSwitch}">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="32" Height="16"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Ellipse x:Name="Knob"
                                     Width="10" Height="10"
                                     Fill="{DynamicResource Wcu.Brush.Text.Secondary}"
                                     HorizontalAlignment="Left"
                                     Margin="2,0" />
                        </Border>
                        <ContentPresenter x:Name="ContentHost"
                                          Grid.Column="1"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill"
                                    Value="{DynamicResource Wcu.Brush.Text.OnAccent}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                            <Setter TargetName="Track" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
