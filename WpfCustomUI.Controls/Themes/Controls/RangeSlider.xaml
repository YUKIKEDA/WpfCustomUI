<!--
    RangeSlider の既定スタイル(spec 6.9.3)。
    Thumb・範囲バーの配置は RangeSlider 本体(コード)が Canvas 上で行う。
    見た目は標準 Slider(Slider.xaml)と揃えている。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <!-- 両端の Thumb(Wcu.Slider.Thumb と同形。辞書が別ファイルのため複製) -->
    <Style x:Key="Wcu.RangeSlider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Root"
                            CornerRadius="6"
                            Background="{DynamicResource Wcu.Brush.Accent.Default}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 中央の選択範囲バー(幅を保ったままのスライドに対応。掴み領域はトラック全高) -->
    <Style x:Key="Wcu.RangeSlider.RangeThumb.Horizontal" TargetType="{x:Type Thumb}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="SizeAll" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Height="4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Wcu.Brush.Accent.Default}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Wcu.RangeSlider.RangeThumb.Vertical" TargetType="{x:Type Thumb}"
           BasedOn="{StaticResource Wcu.RangeSlider.RangeThumb.Horizontal}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="Transparent">
                        <Border x:Name="Bar"
                                Width="4"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource Wcu.Brush.Accent.Default}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Hover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Wcu.Brush.Accent.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:RangeSlider}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:RangeSlider}">
                    <Grid MinHeight="18">
                        <!-- 背景トラック(両端は Thumb の中心に合わせて内側に寄せる) -->
                        <Border Height="4"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                CornerRadius="2"
                                Background="{DynamicResource Wcu.Brush.Control.Hover}" />
                        <Canvas x:Name="PART_Canvas" ClipToBounds="False">
                            <Thumb x:Name="PART_RangeThumb"
                                   Style="{StaticResource Wcu.RangeSlider.RangeThumb.Horizontal}" />
                            <Thumb x:Name="PART_LowerThumb"
                                   Style="{StaticResource Wcu.RangeSlider.Thumb}" />
                            <Thumb x:Name="PART_UpperThumb"
                                   Style="{StaticResource Wcu.RangeSlider.Thumb}" />
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type wcu:RangeSlider}">
                            <Grid MinWidth="18">
                                <Border Width="4"
                                        Margin="0,6"
                                        HorizontalAlignment="Center"
                                        CornerRadius="2"
                                        Background="{DynamicResource Wcu.Brush.Control.Hover}" />
                                <Canvas x:Name="PART_Canvas" ClipToBounds="False">
                                    <Thumb x:Name="PART_RangeThumb"
                                           Style="{StaticResource Wcu.RangeSlider.RangeThumb.Vertical}" />
                                    <Thumb x:Name="PART_LowerThumb"
                                           Style="{StaticResource Wcu.RangeSlider.Thumb}" />
                                    <Thumb x:Name="PART_UpperThumb"
                                           Style="{StaticResource Wcu.RangeSlider.Thumb}" />
                                </Canvas>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
