<!-- GroupBox(spec 6.8.1)。ヘッダーを枠の上に置く現代的なレイアウト(Expander と整合) -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Wcu.GroupBox" TargetType="{x:Type GroupBox}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Wcu.Padding.Panel}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentPresenter ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          TextElement.FontWeight="SemiBold"
                                          Margin="0,0,0,4" />
                        <Border Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Wcu.CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GroupBox}" BasedOn="{StaticResource Wcu.GroupBox}" />

</ResourceDictionary>
