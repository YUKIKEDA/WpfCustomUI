<!-- カラーマップ凡例の既定スタイル(spec 6.4)。目盛はコードビハインドが PART_TickHost に描画する -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style TargetType="{x:Type wcu:ColorMapLegend}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Wcu.FontSize.S}" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:ColorMapLegend}">
                    <DockPanel>
                        <TextBlock x:Name="TitleText"
                                   DockPanel.Dock="Top"
                                   Text="{TemplateBinding Title}"
                                   Margin="0,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="14"
                                    Background="{TemplateBinding LegendBrush}"
                                    BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                                    BorderThickness="1" />
                            <Canvas x:Name="PART_TickHost"
                                    Grid.Column="1"
                                    Width="56"
                                    Margin="2,0,0,0" />
                        </Grid>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
