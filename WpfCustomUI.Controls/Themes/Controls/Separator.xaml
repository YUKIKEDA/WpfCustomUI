<!--
    汎用 Separator(spec 6.8.1)。
    メニュー内(MenuItem.SeparatorStyleKey)/ツールバー内(ToolBar.SeparatorStyleKey)/
    ステータスバー内(StatusBar.SeparatorStyleKey)は各ファイルの専用スタイルが優先される。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Wcu.Separator" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1" Fill="{DynamicResource Wcu.Brush.Border.Default}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Separator}" BasedOn="{StaticResource Wcu.Separator}" />

</ResourceDictionary>
