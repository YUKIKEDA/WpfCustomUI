<!--
    WcuIcon の既定スタイル。
    16x16 キャンバスの Geometry を Viewbox で拡大するため、
    ストローク太さが表示サイズに比例してスケールする。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Style TargetType="{x:Type wcu:WcuIcon}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:WcuIcon}">
                    <Viewbox Width="{TemplateBinding Size}"
                             Height="{TemplateBinding Size}"
                             Stretch="Uniform">
                        <Grid Width="16" Height="16">
                            <Path Data="{TemplateBinding Icon}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="{TemplateBinding StrokeThickness}"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
