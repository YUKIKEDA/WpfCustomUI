<!--
    WcuWindow / WcuDialogWindow の既定スタイル(spec 6.8.4 / 6.8.5)。
    WindowChrome を使い、リサイズ・スナップ・Win+矢印などの OS 挙動を保ったまま
    タイトルバーだけを自前描画する。キャプションボタンは SystemCommands 経由
    (コマンドバインディングは WcuWindow のコンストラクタで登録済み)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <!-- ================= キャプションボタン ================= -->

    <Style x:Key="Wcu.Window.CaptionButton" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="44" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Control.Pressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 閉じるボタンだけはホバー色を赤にする(OS 慣習) -->
    <Style x:Key="Wcu.Window.CaptionCloseButton" TargetType="{x:Type Button}"
           BasedOn="{StaticResource Wcu.Window.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E81123" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#F1707A" />
                <Setter Property="Foreground" Value="#FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <StreamGeometry x:Key="Wcu.Icon.WindowMinimize">M0,5.5 H10</StreamGeometry>
    <StreamGeometry x:Key="Wcu.Icon.WindowMaximize">M0.5,0.5 H9.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Wcu.Icon.WindowRestore">M2.5,0.5 H9.5 V7.5 H7.5 M0.5,2.5 H7.5 V9.5 H0.5 Z</StreamGeometry>
    <StreamGeometry x:Key="Wcu.Icon.WindowClose">M0,0 L10,10 M10,0 L0,10</StreamGeometry>

    <!-- ================= WcuWindow ================= -->

    <Style TargetType="{x:Type wcu:WcuWindow}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Wcu.FontFamily.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Wcu.FontSize.M}" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="32"
                              ResizeBorderThickness="6"
                              CornerRadius="0"
                              GlassFrameThickness="0,0,0,1"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:WcuWindow}">
                    <Border x:Name="WindowRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- タイトルバー -->
                            <Grid Grid.Row="0" Background="{DynamicResource Wcu.Brush.Surface.Panel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image x:Name="IconImage"
                                       Source="{TemplateBinding Icon}"
                                       Width="16" Height="16"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                                <TextBlock x:Name="TitleText"
                                           Grid.Column="1"
                                           Text="{TemplateBinding Title}"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Primary}" />
                                <ContentPresenter Grid.Column="2"
                                                  Content="{TemplateBinding TitleBarContent}"
                                                  VerticalAlignment="Center"
                                                  WindowChrome.IsHitTestVisibleInChrome="True" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button x:Name="MinimizeButton"
                                            Style="{StaticResource Wcu.Window.CaptionButton}"
                                            Command="{x:Static SystemCommands.MinimizeWindowCommand}">
                                        <Path Data="{StaticResource Wcu.Icon.WindowMinimize}"
                                              Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="MaximizeButton"
                                            Style="{StaticResource Wcu.Window.CaptionButton}"
                                            Command="{x:Static SystemCommands.MaximizeWindowCommand}">
                                        <Path Data="{StaticResource Wcu.Icon.WindowMaximize}"
                                              Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="RestoreButton"
                                            Style="{StaticResource Wcu.Window.CaptionButton}"
                                            Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                            Visibility="Collapsed">
                                        <Path Data="{StaticResource Wcu.Icon.WindowRestore}"
                                              Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <Button x:Name="CloseButton"
                                            Style="{StaticResource Wcu.Window.CaptionCloseButton}"
                                            Command="{x:Static SystemCommands.CloseWindowCommand}">
                                        <Path Data="{StaticResource Wcu.Icon.WindowClose}"
                                              Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- コンテンツ(検証アドーナー用に AdornerDecorator 必須) -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 最大化時は画面外にはみ出す分(リサイズ枠相当)を Padding で補正 -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowRoot" Property="BorderThickness" Value="0" />
                            <Setter TargetName="WindowRoot" Property="Padding" Value="7" />
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinimizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MaximizeButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconImage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleText" Property="Foreground"
                                    Value="{DynamicResource Wcu.Brush.Text.Secondary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= WcuDialogWindow ================= -->

    <Style TargetType="{x:Type wcu:WcuDialogWindow}"
           BasedOn="{StaticResource {x:Type wcu:WcuWindow}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:WcuDialogWindow}">
                    <Border x:Name="WindowRoot"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- タイトルバー(ダイアログは閉じるボタンのみ) -->
                            <Grid Grid.Row="0" Background="{DynamicResource Wcu.Brush.Surface.Panel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Title}"
                                           Margin="14,0,8,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Primary}" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Wcu.Window.CaptionCloseButton}"
                                        Command="{x:Static SystemCommands.CloseWindowCommand}">
                                    <Path Data="{StaticResource Wcu.Icon.WindowClose}"
                                          Width="10" Height="10" Stretch="None" StrokeThickness="1"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </Grid>

                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter />
                            </AdornerDecorator>

                            <!-- ボタンバー(Footer が null なら非表示) -->
                            <Border x:Name="FooterBar"
                                    Grid.Row="2"
                                    Background="{DynamicResource Wcu.Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,10">
                                <ContentPresenter Content="{TemplateBinding Footer}"
                                                  HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
