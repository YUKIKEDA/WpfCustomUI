<!--
    SearchBox の既定スタイル(spec 6.8.1)。
    Generic.xaml 単独でも解決できるよう自己完結にしている(内部 TextBox はインラインで無装飾化)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Geometry x:Key="Wcu.Icon.Search">M6.5,1.5 A5,5 0 1 1 6.5,11.5 A5,5 0 1 1 6.5,1.5 Z M6.5,3 A3.5,3.5 0 1 0 6.5,10 A3.5,3.5 0 1 0 6.5,3 Z M10.6,9.5 L14.6,13.5 L13.5,14.6 L9.5,10.6 Z</Geometry>
    <Geometry x:Key="Wcu.Icon.Clear">M3.2,2.5 L8,7.3 L12.8,2.5 L13.5,3.2 L8.7,8 L13.5,12.8 L12.8,13.5 L8,8.7 L3.2,13.5 L2.5,12.8 L7.3,8 L2.5,3.2 Z</Geometry>

    <Style TargetType="{x:Type wcu:SearchBox}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:SearchBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left"
                                  Data="{StaticResource Wcu.Icon.Search}"
                                  Fill="{DynamicResource Wcu.Brush.Text.Secondary}"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center" />
                            <Button x:Name="PART_ClearButton"
                                    DockPanel.Dock="Right"
                                    Width="18" Height="18"
                                    Margin="2,0,3,0"
                                    Focusable="False"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="ClearRoot" Background="Transparent" CornerRadius="2">
                                            <Path Data="{StaticResource Wcu.Icon.Clear}"
                                                  Fill="{DynamicResource Wcu.Brush.Text.Secondary}"
                                                  Width="9" Height="9"
                                                  Stretch="Uniform"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ClearRoot" Property="Background"
                                                        Value="{DynamicResource Wcu.Brush.Control.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Grid>
                                <TextBox x:Name="InputBox"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         Foreground="{TemplateBinding Foreground}"
                                         CaretBrush="{DynamicResource Wcu.Brush.Text.Primary}"
                                         BorderThickness="0"
                                         Padding="4,0"
                                         VerticalContentAlignment="Center">
                                    <TextBox.Template>
                                        <ControlTemplate TargetType="{x:Type TextBox}">
                                            <ScrollViewer x:Name="PART_ContentHost"
                                                          Margin="{TemplateBinding Padding}"
                                                          VerticalAlignment="Center"
                                                          Focusable="False"
                                                          HorizontalScrollBarVisibility="Hidden"
                                                          VerticalScrollBarVisibility="Hidden" />
                                        </ControlTemplate>
                                    </TextBox.Template>
                                </TextBox>
                                <TextBlock x:Name="PlaceholderText"
                                           Text="{TemplateBinding Placeholder}"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Disabled}"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 未入力時: プレースホルダー表示+クリアボタン非表示 -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
