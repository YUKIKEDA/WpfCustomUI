<!--
    InfoBar の既定スタイル(spec 6.10.2)。
    左端の色帯+アイコンで重要度を示す。背景は Surface.Elevated のまま
    (トーン全体を壊さないよう、色はアクセントに限定する)。
    アイコンは EvenOdd の抜きでグリフを表現した単一 Path。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <Geometry x:Key="Wcu.Icon.InfoBar.Info">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M7,6.6 L9,6.6 L9,12 L7,12 Z M7,4 L9,4 L9,5.6 L7,5.6 Z</Geometry>
    <Geometry x:Key="Wcu.Icon.InfoBar.Success">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M4.4,8.3 L5.5,7.2 L7.1,8.8 L10.5,5.4 L11.6,6.5 L7.1,11 Z</Geometry>
    <Geometry x:Key="Wcu.Icon.InfoBar.Warning">M8,1.2 L15.4,14.2 L0.6,14.2 Z M7.2,6 L8.8,6 L8.6,10 L7.4,10 Z M7.3,11 L8.7,11 L8.7,12.4 L7.3,12.4 Z</Geometry>
    <Geometry x:Key="Wcu.Icon.InfoBar.Error">M8,1 A7,7 0 1 0 8,15 A7,7 0 1 0 8,1 Z M5.3,4.4 L8,7.1 L10.7,4.4 L11.6,5.3 L8.9,8 L11.6,10.7 L10.7,11.6 L8,8.9 L5.3,11.6 L4.4,10.7 L7.1,8 L4.4,5.3 Z</Geometry>

    <!-- 閉じるボタン(透明な小型ボタン) -->
    <Style x:Key="Wcu.InfoBar.CloseButton" TargetType="{x:Type Button}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="2">
                        <Path Data="M0,0 L8,8 M8,0 L0,8"
                              Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                              StrokeThickness="1.2"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:InfoBar}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Elevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:InfoBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 重要度の色帯 -->
                            <Border x:Name="Stripe"
                                    Width="3"
                                    Background="{DynamicResource Wcu.Brush.Info}"
                                    CornerRadius="1.5"
                                    Margin="2"
                                    VerticalAlignment="Stretch" />
                            <Path x:Name="Icon"
                                  Grid.Column="1"
                                  Data="{StaticResource Wcu.Icon.InfoBar.Info}"
                                  Fill="{DynamicResource Wcu.Brush.Info}"
                                  Width="14" Height="14"
                                  Stretch="Uniform"
                                  Margin="8,8,0,8"
                                  VerticalAlignment="Top" />
                            <!-- タイトル+メッセージ(折り返し可) -->
                            <Grid Grid.Column="2" Margin="8,7,0,7" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <!-- アクション(Button / Hyperlink 等) -->
                            <ContentPresenter x:Name="ActionHost"
                                              Grid.Column="3"
                                              Content="{TemplateBinding ActionContent}"
                                              Margin="12,4,0,4"
                                              VerticalAlignment="Center" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="4"
                                    Style="{StaticResource Wcu.InfoBar.CloseButton}"
                                    Margin="8,6,6,6"
                                    VerticalAlignment="Top"
                                    ToolTip="閉じる"
                                    AutomationProperties.Name="Close" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Wcu.Brush.Success}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource Wcu.Icon.InfoBar.Success}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Wcu.Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Wcu.Brush.Warning}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource Wcu.Icon.InfoBar.Warning}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Wcu.Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="Stripe" Property="Background" Value="{DynamicResource Wcu.Brush.Error}" />
                            <Setter TargetName="Icon" Property="Data" Value="{StaticResource Wcu.Icon.InfoBar.Error}" />
                            <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Wcu.Brush.Error}" />
                        </Trigger>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ActionContent" Value="{x:Null}">
                            <Setter TargetName="ActionHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
