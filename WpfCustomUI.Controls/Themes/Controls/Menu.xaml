<!--
    Menu / MenuItem / ContextMenu / Separator。
    MenuItem は Role(TopLevelHeader / TopLevelItem / SubmenuHeader / SubmenuItem)ごとに
    テンプレートを切り替える。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- トップレベル(メニューバー上)、サブメニューあり -->
    <ControlTemplate x:Key="Wcu.MenuItem.TopLevelHeader" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="Root" Background="Transparent" Padding="10,4">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
            </Border>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Bottom"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource Wcu.Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Wcu.CornerRadius}"
                        Padding="0,2"
                        Margin="0,2,8,8"
                        MinWidth="160">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" />
                    </Border.Effect>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Hover}" />
            </Trigger>
            <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Selected}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- トップレベル、サブメニューなし(クリックで実行) -->
    <ControlTemplate x:Key="Wcu.MenuItem.TopLevelItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Root" Background="Transparent" Padding="10,4">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- サブメニュー内の行(共通レイアウト: チェック/アイコン列 + 本文 + ジェスチャ + 矢印) -->
    <ControlTemplate x:Key="Wcu.MenuItem.SubmenuItem" TargetType="{x:Type MenuItem}">
        <Border x:Name="Root" Background="Transparent" Padding="4,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="24" />
                </Grid.ColumnDefinitions>
                <Path x:Name="CheckGlyph"
                      Data="M 1,5 L 4.5,8.5 L 10,2"
                      Stroke="{DynamicResource Wcu.Brush.Text.Primary}"
                      StrokeThickness="1.4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
                <ContentPresenter x:Name="IconSite"
                                  ContentSource="Icon"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  RecognizesAccessKey="True"
                                  VerticalAlignment="Center"
                                  Margin="4,0" />
                <TextBlock Grid.Column="2"
                           Text="{TemplateBinding InputGestureText}"
                           Foreground="{DynamicResource Wcu.Brush.Text.Secondary}"
                           VerticalAlignment="Center"
                           Margin="12,0,8,0" />
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                <Setter TargetName="IconSite" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- サブメニュー内の行でさらに子メニューを持つもの -->
    <ControlTemplate x:Key="Wcu.MenuItem.SubmenuHeader" TargetType="{x:Type MenuItem}">
        <Grid>
            <Border x:Name="Root" Background="Transparent" Padding="4,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter ContentSource="Icon"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    <ContentPresenter Grid.Column="1"
                                      ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="4,0" />
                    <Path Grid.Column="2"
                          Data="M 0,0 L 4,4 L 0,8"
                          Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                          StrokeThickness="1.4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                   Placement="Right"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Fade">
                <Border Background="{DynamicResource Wcu.Brush.Surface.Elevated}"
                        BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource Wcu.CornerRadius}"
                        Padding="0,2"
                        Margin="0,0,8,8"
                        MinWidth="160">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" />
                    </Border.Effect>
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Wcu.Brush.State.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Wcu.MenuItem" TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template" Value="{StaticResource Wcu.MenuItem.SubmenuItem}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{StaticResource Wcu.MenuItem.TopLevelHeader}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{StaticResource Wcu.MenuItem.TopLevelItem}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource Wcu.MenuItem.SubmenuHeader}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Wcu.Menu" TargetType="{x:Type Menu}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Wcu.ContextMenu" TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource Wcu.Brush.Surface.Elevated}"
                            BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Wcu.CornerRadius}"
                            Padding="0,2"
                            Margin="0,0,8,8"
                            MinWidth="160">
                        <Border.Effect>
                            <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- メニュー内の区切り線 -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
        <Setter Property="Margin" Value="26,3,8,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1" Fill="{DynamicResource Wcu.Brush.Border.Default}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Menu}" BasedOn="{StaticResource Wcu.Menu}" />
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource Wcu.MenuItem}" />
    <Style TargetType="{x:Type ContextMenu}" BasedOn="{StaticResource Wcu.ContextMenu}" />

</ResourceDictionary>
