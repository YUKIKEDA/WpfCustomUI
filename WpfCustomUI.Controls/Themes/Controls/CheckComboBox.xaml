<!--
    CheckComboBox の既定スタイル(spec 6.12.1)。
    閉時はサマリテキスト+シェブロン(ComboBox と同じ見た目)、
    開くとチェックボックス列(+SelectAllContent 指定時は「すべて選択」行)を表示する。
    構成は ComboBox と同じ「外枠 Border + 透明トグル重ね + Popup」。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wcu="clr-namespace:WpfCustomUI.Controls">

    <!-- 行全体がクリック可能なチェックボックス項目 -->
    <Style TargetType="{x:Type wcu:CheckComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:CheckComboBoxItem}">
                    <Border x:Name="Root"
                            Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder"
                                    Width="14" Height="14"
                                    Background="{DynamicResource Wcu.Brush.Surface.Input}"
                                    BorderBrush="{DynamicResource Wcu.Brush.Border.Strong}"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 1.5,6 L 5,9.5 L 10.5,3"
                                      Stroke="{DynamicResource Wcu.Brush.Text.OnAccent}"
                                      StrokeThickness="1.6"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.State.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckBorder" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="CheckBorder" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wcu:CheckComboBox}">
        <Setter Property="Background" Value="{DynamicResource Wcu.Brush.Surface.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Wcu.Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Wcu.Padding.Input}" />
        <Setter Property="MinHeight" Value="{DynamicResource Wcu.ControlHeight}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wcu:CheckComboBox}">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Wcu.CornerRadius}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SummarySite"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding SummaryText}"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PlaceholderSite"
                                           Margin="{TemplateBinding Padding}"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding PlaceholderText}"
                                           Foreground="{DynamicResource Wcu.Brush.Text.Disabled}"
                                           Visibility="Collapsed" />
                                <Path Grid.Column="1"
                                      Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{DynamicResource Wcu.Brush.Text.Secondary}"
                                      StrokeThickness="1.4"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <!-- ドロップダウンを開くための透明トグル(全面) -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Focusable="True"
                                      FocusVisualStyle="{DynamicResource Wcu.FocusVisual}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Rectangle Fill="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                               StaysOpen="False"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,2,8,8"
                                    Background="{DynamicResource Wcu.Brush.Surface.Elevated}"
                                    BorderBrush="{DynamicResource Wcu.Brush.Border.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Wcu.CornerRadius}">
                                <Border.Effect>
                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Opacity="0.4" />
                                </Border.Effect>
                                <DockPanel Margin="0,2">
                                    <!-- 「すべて選択」行(SelectAllContent 指定時のみ表示) -->
                                    <StackPanel x:Name="SelectAllHost" DockPanel.Dock="Top">
                                        <CheckBox x:Name="PART_SelectAllCheckBox"
                                                  Margin="8,3"
                                                  IsThreeState="False"
                                                  IsChecked="{Binding SelectAllState, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Content="{TemplateBinding SelectAllContent}" />
                                        <Separator Margin="4,2" />
                                    </StackPanel>
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SummaryText" Value="">
                            <Setter TargetName="PlaceholderSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SelectAllContent" Value="{x:Null}">
                            <Setter TargetName="SelectAllHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="PART_ToggleButton" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Border.Strong}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush"
                                    Value="{DynamicResource Wcu.Brush.Accent.Default}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Wcu.Brush.Text.Disabled}" />
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Wcu.Brush.Surface.Panel}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
