<!--
    ダークテーマのカラートークン。
    第1層: プリミティブ(Wcu.Color.*) / 第2層: セマンティック(Wcu.Brush.*)。
    スタイルからは必ずセマンティック層を DynamicResource で参照すること(spec 4.1)。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 第1層: プリミティブパレット ================= -->

    <!-- ニュートラルグレー(VS 風。数値が大きいほど暗い) -->
    <Color x:Key="Wcu.Color.Gray.900">#1E1E1E</Color>
    <Color x:Key="Wcu.Color.Gray.850">#252526</Color>
    <Color x:Key="Wcu.Color.Gray.800">#2D2D30</Color>
    <Color x:Key="Wcu.Color.Gray.750">#333337</Color>
    <Color x:Key="Wcu.Color.Gray.725">#37373D</Color>
    <Color x:Key="Wcu.Color.Gray.700">#3F3F46</Color>
    <Color x:Key="Wcu.Color.Gray.600">#55555A</Color>
    <Color x:Key="Wcu.Color.Gray.500">#6E6E73</Color>
    <Color x:Key="Wcu.Color.Gray.400">#969696</Color>
    <Color x:Key="Wcu.Color.Gray.300">#C5C5C5</Color>
    <Color x:Key="Wcu.Color.Gray.100">#F1F1F1</Color>
    <Color x:Key="Wcu.Color.White">#FFFFFF</Color>

    <!-- アクセント(青) -->
    <Color x:Key="Wcu.Color.Blue.400">#1C97EA</Color>
    <Color x:Key="Wcu.Color.Blue.500">#007ACC</Color>
    <Color x:Key="Wcu.Color.Blue.600">#005A9E</Color>
    <Color x:Key="Wcu.Color.Blue.900">#094771</Color>

    <!--
        アクセントの現在値(ThemeManager.SetAccent で実行時に上書きされ得る色キー)。
        ブラシを直接使えない場所(外部ライブラリのテーマ再配色など)は
        この色キーを DynamicResource で参照するとアクセント変更に追従できる。
    -->
    <Color x:Key="Wcu.Color.Accent.Default">#007ACC</Color>
    <Color x:Key="Wcu.Color.Accent.Hover">#1C97EA</Color>
    <Color x:Key="Wcu.Color.Accent.Pressed">#005A9E</Color>
    <Color x:Key="Wcu.Color.Accent.Muted">#094771</Color>

    <!-- ステータス -->
    <Color x:Key="Wcu.Color.Red.500">#F14C4C</Color>
    <Color x:Key="Wcu.Color.Yellow.500">#CCA700</Color>
    <Color x:Key="Wcu.Color.Green.500">#89D185</Color>
    <Color x:Key="Wcu.Color.LightBlue.500">#75BEFF</Color>

    <!-- ================= 第2層: セマンティックブラシ ================= -->

    <!-- Surface -->
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Window" Color="{StaticResource Wcu.Color.Gray.900}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Panel" Color="{StaticResource Wcu.Color.Gray.850}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Elevated" Color="{StaticResource Wcu.Color.Gray.800}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Input" Color="{StaticResource Wcu.Color.Gray.750}" />

    <!-- Text -->
    <SolidColorBrush x:Key="Wcu.Brush.Text.Primary" Color="{StaticResource Wcu.Color.Gray.100}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.Secondary" Color="{StaticResource Wcu.Color.Gray.400}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.Disabled" Color="{StaticResource Wcu.Color.Gray.500}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.OnAccent" Color="{StaticResource Wcu.Color.White}" />

    <!-- Control(ボタン等の対話コントロールの面) -->
    <SolidColorBrush x:Key="Wcu.Brush.Control.Background" Color="{StaticResource Wcu.Color.Gray.750}" />
    <SolidColorBrush x:Key="Wcu.Brush.Control.Hover" Color="{StaticResource Wcu.Color.Gray.700}" />
    <SolidColorBrush x:Key="Wcu.Brush.Control.Pressed" Color="{StaticResource Wcu.Color.Gray.600}" />

    <!-- Border -->
    <SolidColorBrush x:Key="Wcu.Brush.Border.Default" Color="{StaticResource Wcu.Color.Gray.700}" />
    <SolidColorBrush x:Key="Wcu.Brush.Border.Strong" Color="{StaticResource Wcu.Color.Gray.600}" />
    <SolidColorBrush x:Key="Wcu.Brush.Border.Focus" Color="{StaticResource Wcu.Color.Accent.Default}" />

    <!-- Accent(ThemeManager.SetAccent で上書きされ得るキー) -->
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Default" Color="{StaticResource Wcu.Color.Accent.Default}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Hover" Color="{StaticResource Wcu.Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Pressed" Color="{StaticResource Wcu.Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Muted" Color="{StaticResource Wcu.Color.Accent.Muted}" />

    <!-- State(ホバー等は半透明白のオーバーレイ) -->
    <SolidColorBrush x:Key="Wcu.Brush.State.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Wcu.Brush.State.Pressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Wcu.Brush.State.Selected" Color="{StaticResource Wcu.Color.Blue.900}" />
    <SolidColorBrush x:Key="Wcu.Brush.State.SelectedInactive" Color="{StaticResource Wcu.Color.Gray.725}" />

    <!-- Status -->
    <SolidColorBrush x:Key="Wcu.Brush.Error" Color="{StaticResource Wcu.Color.Red.500}" />
    <SolidColorBrush x:Key="Wcu.Brush.Warning" Color="{StaticResource Wcu.Color.Yellow.500}" />
    <SolidColorBrush x:Key="Wcu.Brush.Success" Color="{StaticResource Wcu.Color.Green.500}" />
    <SolidColorBrush x:Key="Wcu.Brush.Info" Color="{StaticResource Wcu.Color.LightBlue.500}" />

</ResourceDictionary>
