<!--
    ダークテーマのカラートークン(VS Dark 準拠)。
    第1層: セマンティック Color(Wcu.Color.Surface.* 等) — 役割ベースの色プリミティブ。
           ブラシを使えない消費者(WpfCustomUI.Docking のドックテーマ、
           WpfCustomUI.Charts のラスタ描画等)は DynamicResource でこちらを参照する。
    第2層: セマンティックブラシ(Wcu.Brush.*)。
    スタイルからは必ずセマンティック層を DynamicResource で参照すること(spec 4.1 / 6.15.2)。
    キー構成は Tokens.Light.xaml と同一に保つこと。

    注意: コンパイル済み(遅延)辞書では StaticResource エイリアスエントリを
    他エントリから参照できないため、Color は実値で定義する。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================= 第1層: セマンティック Color ================= -->

    <!-- Surface(奥まっているほど暗い) -->
    <Color x:Key="Wcu.Color.Surface.Window">#1E1E1E</Color>
    <Color x:Key="Wcu.Color.Surface.Panel">#252526</Color>
    <Color x:Key="Wcu.Color.Surface.Elevated">#2D2D30</Color>
    <Color x:Key="Wcu.Color.Surface.Input">#333337</Color>

    <!-- Text -->
    <Color x:Key="Wcu.Color.Text.Primary">#F1F1F1</Color>
    <Color x:Key="Wcu.Color.Text.Muted">#C5C5C5</Color>
    <Color x:Key="Wcu.Color.Text.Secondary">#969696</Color>
    <Color x:Key="Wcu.Color.Text.Disabled">#6E6E73</Color>
    <Color x:Key="Wcu.Color.Text.OnAccent">#FFFFFF</Color>

    <!-- Control(ボタン等の対話コントロールの面) -->
    <Color x:Key="Wcu.Color.Control.Background">#333337</Color>
    <Color x:Key="Wcu.Color.Control.Hover">#3F3F46</Color>
    <Color x:Key="Wcu.Color.Control.Pressed">#55555A</Color>

    <!-- Border -->
    <Color x:Key="Wcu.Color.Border.Default">#3F3F46</Color>
    <Color x:Key="Wcu.Color.Border.Strong">#55555A</Color>

    <!-- State -->
    <Color x:Key="Wcu.Color.State.Selected">#094771</Color>
    <Color x:Key="Wcu.Color.State.SelectedInactive">#37373D</Color>

    <!-- Status -->
    <Color x:Key="Wcu.Color.Error">#F14C4C</Color>
    <Color x:Key="Wcu.Color.Warning">#CCA700</Color>
    <Color x:Key="Wcu.Color.Success">#89D185</Color>
    <Color x:Key="Wcu.Color.Info">#75BEFF</Color>

    <!-- Danger(破壊的操作ボタンの面。Error は文字/枠用の明るい赤) -->
    <Color x:Key="Wcu.Color.Danger.Default">#C42B1C</Color>
    <Color x:Key="Wcu.Color.Danger.Hover">#D13438</Color>
    <Color x:Key="Wcu.Color.Danger.Pressed">#A4262C</Color>

    <!--
        アクセントの現在値(ThemeManager.SetAccent で実行時に上書きされ得る色キー)。
        ブラシを直接使えない場所はこの色キーを DynamicResource で参照すると
        アクセント変更に追従できる。
    -->
    <Color x:Key="Wcu.Color.Accent.Default">#007ACC</Color>
    <Color x:Key="Wcu.Color.Accent.Hover">#1C97EA</Color>
    <Color x:Key="Wcu.Color.Accent.Pressed">#005A9E</Color>
    <Color x:Key="Wcu.Color.Accent.Muted">#094771</Color>

    <!-- ================= 第2層: セマンティックブラシ ================= -->

    <!-- Surface -->
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Window" Color="{StaticResource Wcu.Color.Surface.Window}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Panel" Color="{StaticResource Wcu.Color.Surface.Panel}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Elevated" Color="{StaticResource Wcu.Color.Surface.Elevated}" />
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Input" Color="{StaticResource Wcu.Color.Surface.Input}" />

    <!-- Text -->
    <SolidColorBrush x:Key="Wcu.Brush.Text.Primary" Color="{StaticResource Wcu.Color.Text.Primary}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.Secondary" Color="{StaticResource Wcu.Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.Disabled" Color="{StaticResource Wcu.Color.Text.Disabled}" />
    <SolidColorBrush x:Key="Wcu.Brush.Text.OnAccent" Color="{StaticResource Wcu.Color.Text.OnAccent}" />

    <!-- Control(ボタン等の対話コントロールの面) -->
    <SolidColorBrush x:Key="Wcu.Brush.Control.Background" Color="{StaticResource Wcu.Color.Control.Background}" />
    <SolidColorBrush x:Key="Wcu.Brush.Control.Hover" Color="{StaticResource Wcu.Color.Control.Hover}" />
    <SolidColorBrush x:Key="Wcu.Brush.Control.Pressed" Color="{StaticResource Wcu.Color.Control.Pressed}" />

    <!-- Border -->
    <SolidColorBrush x:Key="Wcu.Brush.Border.Default" Color="{StaticResource Wcu.Color.Border.Default}" />
    <SolidColorBrush x:Key="Wcu.Brush.Border.Strong" Color="{StaticResource Wcu.Color.Border.Strong}" />
    <SolidColorBrush x:Key="Wcu.Brush.Border.Focus" Color="{StaticResource Wcu.Color.Accent.Default}" />

    <!-- Accent(ThemeManager.SetAccent で上書きされ得るキー) -->
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Default" Color="{StaticResource Wcu.Color.Accent.Default}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Hover" Color="{StaticResource Wcu.Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Pressed" Color="{StaticResource Wcu.Color.Accent.Pressed}" />
    <SolidColorBrush x:Key="Wcu.Brush.Accent.Muted" Color="{StaticResource Wcu.Color.Accent.Muted}" />

    <!-- 交互行など、ごく薄い面の差(半透明白のオーバーレイ) -->
    <SolidColorBrush x:Key="Wcu.Brush.Surface.Alternate" Color="#08FFFFFF" />

    <!-- State(ホバー等は半透明白のオーバーレイ) -->
    <SolidColorBrush x:Key="Wcu.Brush.State.Hover" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Wcu.Brush.State.Pressed" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Wcu.Brush.State.Selected" Color="{StaticResource Wcu.Color.State.Selected}" />
    <SolidColorBrush x:Key="Wcu.Brush.State.SelectedInactive" Color="{StaticResource Wcu.Color.State.SelectedInactive}" />

    <!-- Status -->
    <SolidColorBrush x:Key="Wcu.Brush.Error" Color="{StaticResource Wcu.Color.Error}" />
    <SolidColorBrush x:Key="Wcu.Brush.Warning" Color="{StaticResource Wcu.Color.Warning}" />
    <SolidColorBrush x:Key="Wcu.Brush.Success" Color="{StaticResource Wcu.Color.Success}" />
    <SolidColorBrush x:Key="Wcu.Brush.Info" Color="{StaticResource Wcu.Color.Info}" />

    <!-- Danger -->
    <SolidColorBrush x:Key="Wcu.Brush.Danger.Default" Color="{StaticResource Wcu.Color.Danger.Default}" />
    <SolidColorBrush x:Key="Wcu.Brush.Danger.Hover" Color="{StaticResource Wcu.Color.Danger.Hover}" />
    <SolidColorBrush x:Key="Wcu.Brush.Danger.Pressed" Color="{StaticResource Wcu.Color.Danger.Pressed}" />

</ResourceDictionary>
